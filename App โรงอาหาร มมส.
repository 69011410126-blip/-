if(d.lang){S.lang=d.lang;document.documentElement.lang=d.lang;R();return}
if(d.theme){S.theme=d.theme;applyTheme();R();return}
if(d.do==='saveprofile'){var q=S.pf;if(!q.n.trim()){S.perr='กรอกชื่อที่แสดง';R();return}if(q.p&&q.p.length!==10){S.perr='เบอร์โทรไม่ถูกต้อง ต้องมี 10 หลัก';R();return}S.name=q.n.trim();S.fac=q.f.trim();S.phone=q.p;S.perr='';R();toast('บันทึกโปรไฟล์แล้ว');return}
if(d.s!==undefined){var i=+d.s,m=S.my[i];S.shop=i;S.rate=m?m.s:0;S.rtext=m?m.t:'';S.err='';R();go('shop');return}
if(d.star){S.rate=+d.star;S.err='';R();return}
if(d.do==='review'){if(!S.rate){S.err='เลือกจำนวนดาวก่อนส่งรีวิว';R();return}S.my[S.shop]={s:S.rate,t:S.rtext.trim()};var f=Object.keys(S.my).length>=3&&!S.bonus;if(f){S.bonus=true;S.pts+=30}R();toast(f?'รีวิวครบ 3 ร้าน รับ 30 แต้ม':'ส่งรีวิวแล้ว');return}
if(d.a){S.amt=+d.a;R();return}
if(d.m){S.method=+d.m;R();return}
if(d.n){S.notify=!S.notify;R();toast(S.notify?'เปิดการแจ้งเตือนแล้ว':'ปิดการแจ้งเตือนแล้ว');return}
if(d.r!==undefined){var r=REW[+d.r];if(S.pts<r[1]){toast('แต้มไม่พอ ต้องใช้ '+r[1]+' แต้ม');return}S.pts-=r[1];R();toast('แลก '+r[0]+' แล้ว');return}
if(d.do==='topup'){if(S.blocked){toast('บัตรถูกระงับ เปิดใช้บัตรก่อนเติมเงิน');return}if(!(S.amt>=20)){toast('เติมขั้นต่ำ 20 บาท');return}S.bal+=S.amt;S.tx.unshift(['เติมเงิน '+(S.method?'โมบายแบงก์กิ้ง':'PromptPay'),S.amt]);R();go('home');toast('เติมเงินแล้ว');return}
if(d.do==='block'){if(S.blocked){S.blocked=false;toast('เปิดใช้บัตรแล้ว')}else if(!S.confirmBlock){S.confirmBlock=true}else{S.blocked=true;S.confirmBlock=false;toast('ระงับบัตรแล้ว')}R()}});
$('app').addEventListener('input',function(e){if(e.target.id==='ca'){var v=e.target.value.replace(/\D/g,'');e.target.value=v;S.amt=+v;document.querySelectorAll('.chip').forEach(function(c){c.classList.toggle('on',+c.dataset.a===S.amt)});document.querySelector('[data-do=topup]').textContent=tr('เติมเงิน ฿'+(S.amt||0))}});
$('app').addEventListener('change',function(e){if(e.target.id==='mo'){S.month=e.target.value;R()}
if(e.target.id==='thr'){var v=parseInt(e.target.value,10);if(isNaN(v)||v<0)v=S.thr;S.thr=v;R();toast('ตั้งยอดแจ้งเตือนเป็น ฿'+v)}});
$('app').addEventListener('input',function(e){if(e.target.id==='rt')S.rtext=e.target.value;if(e.target.id==='rx')S.rx=e.target.value;var k={pn:'n',pf:'f',pp:'p'}[e.target.id];if(k){S.pf[k]=e.target.value;if(k==='p'){S.pf.p=e.target.value.replace(/\D/g,'');e.target.value=S.pf.p}}});
var sid=$('sid'),pw=$('pw');
function bad(w,m,t){$(w).classList.toggle('bad',!!t);$(m).textContent=tr(t||'')}
sid.addEventListener('input',function(){sid.value=sid.value.replace(/\D/g,'');bad('w1','e1','')});
pw.addEventListener('input',function(){bad('w2','e2','')});
$('eye').addEventListener('click',function(){var s=pw.type==='password';pw.type=s?'text':'password';this.textContent=tr(s?'ซ่อน':'แสดง');this.setAttribute('aria-label',tr(s?'ซ่อนรหัสผ่าน':'แสดงรหัสผ่าน'))});
$('lf').addEventListener('submit',function(e){e.preventDefault();var a=false;
if(!sid.value){bad('w1','e1','กรอกรหัสนิสิต');a=true}else if(sid.value.length<8){bad('w1','e1','รหัสนิสิตสั้นเกินไป ตรวจสอบอีกครั้ง');a=true}
if(!pw.value){bad('w2','e2','กรอกรหัสผ่าน');a=true}
if(a)return;S.sid=sid.value;R();go('home')});
R();
</script>
</body>
</html>
