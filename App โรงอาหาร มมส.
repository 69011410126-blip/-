.stars{display:flex;gap:4px;margin:6px 0 10px}
.star{background:none;border:0;font-size:34px;line-height:1;padding:2px 4px}
textarea{width:100%;background:var(--field);border:1.5px solid var(--line);border-radius:12px;padding:12px;font:inherit;font-size:15px;color:var(--text);resize:vertical;outline:0}
