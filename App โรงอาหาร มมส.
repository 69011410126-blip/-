.menu{display:grid;grid-template-columns:1fr 1fr;gap:2px 10px;font-size:13px;color:var(--sub);margin-top:6px}
.toast{position:fixed;left:50%;bottom:88px;transform:translateX(-50%);background:var(--text);color:var(--sheet);padding:10px 16px;border-radius:10px;font-size:14px;opacity:0;pointer-events:none;transition:opacity .2s;max-width:340px;text-align:center;z-index:9}
.toast.on{opacity:1}
</style>
</head>
